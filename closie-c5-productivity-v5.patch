+                )
+            }
+            OutlinedTextField(
+                value = name,
+                onValueChange = { name = it },
+                modifier = Modifier.fillMaxWidth(),
+                label = { Text("商品名") },
+                singleLine = true,
+                shape = RoundedCornerShape(12.dp)

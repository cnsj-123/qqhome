diff --git a/app/src/main/java/com/qq/closie/data/backup/EncryptedBackupEnvelope.kt b/app/src/main/java/com/qq/closie/data/backup/EncryptedBackupEnvelope.kt
new file mode 100644
index 0000000000000000000000000000000000000000..55b681cdaacfafdf9d7792e544081d37c127606c
--- /dev/null
+++ b/app/src/main/java/com/qq/closie/data/backup/EncryptedBackupEnvelope.kt
@@ -0,0 +1,118 @@
+package com.qq.closie.data.backup
+
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.InputStream
+import java.io.OutputStream
+import java.nio.ByteBuffer
+import java.security.SecureRandom
+import javax.crypto.Cipher
+import javax.crypto.SecretKeyFactory
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.PBEKeySpec
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * Portable, versioned authenticated framing over JCA AES-256-GCM.
+ * Each 64 KiB record authenticates the complete header, sequence and plaintext length. A mandatory
+ * authenticated empty final record prevents truncation. No record nonce repeats under a derived key.
+ * Decrypt writes private staging only; the caller publishes nothing until the final record verifies.
+ */
+object EncryptedBackupEnvelope {
+    private val magic = "LIFEOS5E".toByteArray(Charsets.US_ASCII)
+    private const val VERSION = 2
+    private const val ITERATIONS = 600_000
+    private const val HEADER_SIZE = 44
+    private const val CHUNK = 64 * 1024
+    private const val MAX_BYTES = 8L * 1024 * 1024 * 1024
+
+    fun encrypt(input: InputStream, output: OutputStream, password: CharArray) {
+        require(password.size >= 12) { "备份口令至少 12 个字符，请单独妥善保管" }
+        val random = SecureRandom()
+        val salt = ByteArray(16).also(random::nextBytes)
+        val noncePrefix = ByteArray(8).also(random::nextBytes)
+        val header = ByteBuffer.allocate(HEADER_SIZE).put(magic).putInt(VERSION).putInt(ITERATIONS)
+            .put(salt).put(noncePrefix).putInt(CHUNK).array()
+        val key = derive(password, salt, ITERATIONS)
+        val buffer = ByteArray(CHUNK)
+        try {
+            val out = DataOutputStream(output)
+            out.write(header)
+            var sequence = 0
+            var total = 0L
+            while (true) {
+                val size = readChunk(input, buffer)
+                total = Math.addExact(total, size.toLong())
+                require(total <= MAX_BYTES) { "备份超过当前安全大小限制" }
+                val metadata = ByteBuffer.allocate(8).putInt(sequence).putInt(size).array()
+                val cipher = cipher(Cipher.ENCRYPT_MODE, key, noncePrefix, sequence, header, metadata)
+                out.write(metadata); out.write(cipher.doFinal(buffer, 0, size))
+                if (size == 0) break
+                sequence = Math.addExact(sequence, 1)
+            }
+        } finally { key.fill(0); buffer.fill(0) }
+    }
+
+    fun decrypt(input: InputStream, output: OutputStream, password: CharArray) {
+        val source = DataInputStream(input)
+        val header = ByteArray(HEADER_SIZE)
+        source.readFully(header)
+        val values = ByteBuffer.wrap(header)
+        val found = ByteArray(8); values.get(found)
+        require(found.contentEquals(magic) && values.int == VERSION) { "不支持的加密备份格式" }
+        val rounds = values.int
+        require(rounds in ITERATIONS..1_200_000) { "加密备份参数无效" }
+        val salt = ByteArray(16); values.get(salt)
+        val prefix = ByteArray(8); values.get(prefix)
+        require(values.int == CHUNK) { "加密备份分段参数无效" }
+        val key = derive(password, salt, rounds)
+        try {
+            var sequence = 0
+            var total = 0L
+            while (true) {
+                val index = source.readInt()
+                val size = source.readInt()
+                require(index == sequence && size in 0..CHUNK) { "加密备份记录顺序或大小无效" }
+                total = Math.addExact(total, size.toLong())
+                require(total <= MAX_BYTES) { "备份超过当前安全大小限制" }
+                val encrypted = ByteArray(size + 16)
+                source.readFully(encrypted)
+                val metadata = ByteBuffer.allocate(8).putInt(index).putInt(size).array()
+                val clear = cipher(Cipher.DECRYPT_MODE, key, prefix, index, header, metadata).doFinal(encrypted)
+                try {
+                    check(clear.size == size)
+                    if (size == 0) {
+                        require(source.read() == -1) { "加密备份存在未认证尾部" }
+                        break
+                    }
+                    output.write(clear)
+                } finally { clear.fill(0) }
+                sequence = Math.addExact(sequence, 1)
+            }
+        } catch (e: javax.crypto.AEADBadTagException) {
+            throw IllegalArgumentException("口令错误或备份已损坏，原数据未修改", e)
+        } finally { key.fill(0) }
+    }
+
+    private fun derive(password: CharArray, salt: ByteArray, rounds: Int): ByteArray {
+        val spec = PBEKeySpec(password, salt, rounds, 256)
+        return try { SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).encoded }
+            finally { spec.clearPassword() }
+    }
+    private fun cipher(mode: Int, key: ByteArray, prefix: ByteArray, sequence: Int,
+        header: ByteArray, metadata: ByteArray): Cipher = Cipher.getInstance("AES/GCM/NoPadding").apply {
+        val nonce = ByteBuffer.allocate(12).put(prefix).putInt(sequence).array()
+        init(mode, SecretKeySpec(key, "AES"), GCMParameterSpec(128, nonce))
+        updateAAD(header); updateAAD(metadata)
+    }
+    private fun readChunk(input: InputStream, buffer: ByteArray): Int {
+        var size = 0
+        while (size < buffer.size) {
+            val count = input.read(buffer, size, buffer.size - size)
+            if (count < 0) break
+            if (count == 0) continue
+            size += count
+        }
+        return size
+    }
+}
diff --git a/app/src/main/java/com/qq/closie/data/backup/EncryptedBackupManager.kt b/app/src/main/java/com/qq/closie/data/backup/EncryptedBackupManager.kt
new file mode 100644
index 0000000000000000000000000000000000000000..1f0b12b2c453d6abb7a474a3aa9759c99d69d108
--- /dev/null
+++ b/app/src/main/java/com/qq/closie/data/backup/EncryptedBackupManager.kt
@@ -0,0 +1,75 @@
+package com.qq.closie.data.backup
+
+import android.content.Context
+import android.net.Uri
+import com.qq.closie.data.repository.WardrobeRepository
+import com.qq.closie.life.data.database.LifeDatabase
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.OutputStream
+import java.security.MessageDigest
+import java.util.UUID
+
+/** Encrypts the existing complete typed backup, and verifies stored bytes before reporting success. */
+object EncryptedBackupManager {
+    /** Crash leftovers are private cache, never a recovery credential or authoritative data. */
+    fun cleanInterruptedScratch(context: Context) {
+        val root = context.cacheDir.canonicalFile
+        root.listFiles()?.filter { it.name.startsWith("secure_backup_") || it.name.startsWith("secure_restore_") }?.forEach {
+            if (it.canonicalFile.parentFile == root) it.deleteRecursively()
+        }
+    }
+    suspend fun export(context: Context, repo: WardrobeRepository, uri: Uri, db: LifeDatabase,
+        password: CharArray): Result<Unit> = withContext(Dispatchers.IO) {
+        val scratch = File(context.cacheDir, "secure_backup_" + UUID.randomUUID())
+        try {
+            runCatching {
+                check(scratch.mkdirs()) { "无法创建备份暂存目录" }
+                val plain = File(scratch, "payload.zip")
+                BackupManager.export(context, repo, Uri.fromFile(plain), db).getOrThrow()
+                val encrypted = File(scratch, "payload.lifeos")
+                plain.inputStream().use { input -> encrypted.outputStream().use { output ->
+                    EncryptedBackupEnvelope.encrypt(input, output, password)
+                } }
+                val expected = digest(plain)
+                val verified = MessageDigest.getInstance("SHA-256")
+                encrypted.inputStream().use { input ->
+                    EncryptedBackupEnvelope.decrypt(input, object : OutputStream() {
+                        override fun write(b: Int) { verified.update(b.toByte()) }
+                        override fun write(b: ByteArray, off: Int, len: Int) { verified.update(b, off, len) }
+                    }, password)
+                }
+                check(expected.contentEquals(verified.digest())) { "加密备份恢复校验未通过" }
+                val resolver = context.contentResolver
+                requireNotNull(resolver.openOutputStream(uri, "wt")) { "无法写入备份文件" }.use { out ->
+                    encrypted.inputStream().use { it.copyTo(out) }
+                }
+                val stored = requireNotNull(resolver.openInputStream(uri)) { "无法重新读取并验证已写入的备份" }.use(::digest)
+                check(stored.contentEquals(digest(encrypted))) { "备份文件写入不完整" }
+            }
+        } finally { password.fill('\u0000'); scratch.deleteRecursively() }
+    }
+
+    suspend fun restore(context: Context, repo: WardrobeRepository, uri: Uri, db: LifeDatabase,
+        password: CharArray): Result<Unit> = withContext(Dispatchers.IO) {
+        val scratch = File(context.cacheDir, "secure_restore_" + UUID.randomUUID())
+        try { runCatching {
+            check(scratch.mkdirs()) { "无法创建恢复暂存目录" }
+            val plain = File(scratch, "verified.zip")
+            requireNotNull(context.contentResolver.openInputStream(uri)).use { input ->
+                plain.outputStream().use { output -> EncryptedBackupEnvelope.decrypt(input, output, password) }
+            }
+            // Authentication completed before the existing staging/coordinator sees any bytes.
+            BackupManager.restore(context, repo, Uri.fromFile(plain), db).getOrThrow()
+        } } finally { password.fill('\u0000'); scratch.deleteRecursively() }
+    }
+
+    private fun digest(file: File) = file.inputStream().use(::digest)
+    private fun digest(input: java.io.InputStream): ByteArray {
+        val hash = MessageDigest.getInstance("SHA-256")
+        val buffer = ByteArray(64 * 1024)
+        while (true) { val count = input.read(buffer); if (count < 0) break; if (count > 0) hash.update(buffer, 0, count) }
+        return hash.digest()
+    }
+}

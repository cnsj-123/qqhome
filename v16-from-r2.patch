diff --git a/app/src/test/java/com/qq/closie/data/backup/EncryptedBackupEnvelopeTest.kt b/app/src/test/java/com/qq/closie/data/backup/EncryptedBackupEnvelopeTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..8ad3f691eb2cf68b0319fe5841b3c235a9d979ba
--- /dev/null
+++ b/app/src/test/java/com/qq/closie/data/backup/EncryptedBackupEnvelopeTest.kt
@@ -0,0 +1,52 @@
+package com.qq.closie.data.backup
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+
+class EncryptedBackupEnvelopeTest {
+    private val password get() = "synthetic-only-passphrase".toCharArray()
+    private fun encrypt(bytes: ByteArray): ByteArray = ByteArrayOutputStream().also {
+        EncryptedBackupEnvelope.encrypt(ByteArrayInputStream(bytes), it, password)
+    }.toByteArray()
+    private fun decrypt(bytes: ByteArray, key: CharArray = password): ByteArray = ByteArrayOutputStream().also {
+        EncryptedBackupEnvelope.decrypt(ByteArrayInputStream(bytes), it, key)
+    }.toByteArray()
+
+    @Test fun T11_portableRoundTripUsesFreshSaltAndAuthenticatesAllBytes() {
+        val plain = "合成 Gift / Unknown / obligation / -40 / 附件身份".repeat(100).toByteArray()
+        val first = encrypt(plain)
+        assertArrayEquals(plain, decrypt(first))
+        assertFalse(first.contentEquals(encrypt(plain)))
+        assertFalse(String(first, Charsets.ISO_8859_1).contains("obligation"))
+        for (position in listOf(0, 12, 20, 40, first.lastIndex)) {
+            val damaged = first.copyOf(); damaged[position] = (damaged[position].toInt() xor 1).toByte()
+            assertTrue(runCatching { decrypt(damaged) }.isFailure)
+        }
+        assertTrue(runCatching { decrypt(first.copyOf(first.size - 1)) }.isFailure)
+        assertTrue(runCatching { decrypt(first, "synthetic-wrong-password".toCharArray()) }.isFailure)
+    }
+
+    @Test fun malformedHeaderIsRejectedBeforeAnUnboundedKdfCanRun() {
+        val bytes = encrypt(byteArrayOf(1))
+        java.nio.ByteBuffer.wrap(bytes).putInt(12, Int.MAX_VALUE)
+        assertTrue(runCatching { decrypt(bytes) }.isFailure)
+        assertTrue(runCatching { EncryptedBackupEnvelope.encrypt(ByteArrayInputStream(byteArrayOf()), ByteArrayOutputStream(), "short".toCharArray()) }.isFailure)
+    }
+
+    @Test fun authenticatedSegmentsRejectTruncationDuplicationOrderAndTrailingBytes() {
+        val plain = ByteArray(180_000) { (it % 251).toByte() }
+        val encrypted = encrypt(plain)
+        assertArrayEquals(plain, decrypt(encrypted))
+        val firstEnd = 44 + 8 + 65_536 + 16
+        val segment = encrypted.copyOfRange(44, firstEnd)
+        val duplicated = encrypted.copyOfRange(0, firstEnd) + segment + encrypted.copyOfRange(firstEnd, encrypted.size)
+        assertTrue(runCatching { decrypt(duplicated) }.isFailure)
+        assertTrue(runCatching { decrypt(encrypted.copyOf(firstEnd)) }.isFailure)
+        assertTrue(runCatching { decrypt(encrypted + byteArrayOf(0)) }.isFailure)
+        val reordered = encrypted.copyOf()
+        java.nio.ByteBuffer.wrap(reordered).putInt(44, 1)
+        assertTrue(runCatching { decrypt(reordered) }.isFailure)
+    }
+}
diff --git a/app/src/test/java/com/qq/closie/data/backup/EncryptedBackupManagerV16Test.kt b/app/src/test/java/com/qq/closie/data/backup/EncryptedBackupManagerV16Test.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e0e0f681de1364f7101a327491bfcf1f9542f999
--- /dev/null
+++ b/app/src/test/java/com/qq/closie/data/backup/EncryptedBackupManagerV16Test.kt
@@ -0,0 +1,81 @@
+package com.qq.closie.data.backup
+
+import android.content.Context
+import android.net.Uri
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.qq.closie.data.repository.LocalWardrobeRepository
+import com.qq.closie.life.data.database.LifeDatabase
+import com.qq.closie.life.finance.*
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/** Actual manager/URI/archive boundary, beyond the standalone AEAD envelope tests. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk=[34])
+class EncryptedBackupManagerV16Test:FinanceRoomTest() {
+    @get:Rule val files=TemporaryFolder()
+    private val context:Context get()=ApplicationProvider.getApplicationContext()
+    private fun password()="synthetic-only-password".toCharArray()
+    private fun assertScratchClean() {
+        assertTrue(context.cacheDir.listFiles().orEmpty().none {it.name.startsWith("secure_backup_") || it.name.startsWith("secure_restore_")})
+    }
+    private suspend fun seedUnknown():String {
+        val economics=finance.economics
+        val friend=economics.saveParty(economics.token(),"合成外部付款方")
+        return economics.confirmEconomic(economics.token(),FinanceEconomicInput(description="合成未知关系",currencyCode="CNY",
+            occurredAt=clock,valueMinor=12_345,valueBasis="合成确认",categoryId=null,allocationsComplete=true,
+            funding=listOf(FinanceFundingInput("fund",friend,12_345,basis="合成外部付款")),
+            shares=listOf(FinanceShareInput("share",12_345,"self",null,"fund",FinanceShareRelation.UNRESOLVED))))
+    }
+
+    @Test fun wrongPasswordAndLateCorruptionCannotReachCanonicalRestoreAndScratchIsRemoved()=runTest {
+        seedUnknown();val wardrobe=LocalWardrobeRepository(context)
+        val encrypted=files.newFile("synthetic.lifeos");val key=password()
+        assertTrue(EncryptedBackupManager.export(context,wardrobe,Uri.fromFile(encrypted),db,key).isSuccess)
+        assertTrue(key.all {it=='\u0000'});assertScratchClean()
+        val original=encrypted.readBytes();val before=finance.portableSnapshot()
+        val wrong="synthetic-wrong-password".toCharArray()
+        assertTrue(EncryptedBackupManager.restore(context,wardrobe,Uri.fromFile(encrypted),db,wrong).isFailure)
+        assertTrue(wrong.all {it=='\u0000'});assertEquals(before,finance.portableSnapshot());assertScratchClean()
+        val damaged=original.copyOf();damaged[damaged.lastIndex]=(damaged.last().toInt() xor 1).toByte()
+        encrypted.writeBytes(damaged)
+        val second=password()
+        assertTrue(EncryptedBackupManager.restore(context,wardrobe,Uri.fromFile(encrypted),db,second).isFailure)
+        assertTrue(second.all {it=='\u0000'});assertEquals(before,finance.portableSnapshot());assertScratchClean()
+    }
+
+    @Test fun verifiedManagerArchiveRestoresTypedUnknownToAnotherDatabaseAndRevokesGrant()=runTest {
+        val event=seedUnknown();val wardrobe=LocalWardrobeRepository(context)
+        finance.workspace.grant(finance.economics.token(),FinanceReadPurpose.HOME,"home-memory",setOf(event),emptySet(),
+            true,true,true,Long.MAX_VALUE)
+        val encrypted=files.newFile("portable.lifeos")
+        assertTrue(EncryptedBackupManager.export(context,wardrobe,Uri.fromFile(encrypted),db,password()).isSuccess)
+        val target=Room.inMemoryDatabaseBuilder(context,LifeDatabase::class.java).allowMainThreadQueries().build()
+        try {
+            val key=password()
+            assertTrue(EncryptedBackupManager.restore(context,wardrobe,Uri.fromFile(encrypted),target,key).isSuccess)
+            val restored=FinanceRepository(target).portableSnapshot()
+            assertTrue(key.all {it=='\u0000'});assertScratchClean()
+            assertEquals(event,restored.v4!!.events.single().id)
+            assertTrue(restored.entries.isEmpty())
+            assertEquals(PersonalCostTotal(0,1),FinanceCostProjection.eventTotal(restored,event))
+            assertTrue(restored.v16!!.purposeGrantRows.all {it.voidedAt!=null})
+            assertEquals(1L,restored.v16!!.controlRows.single().restoreEpoch)
+            FinanceIntegrity.validate(restored)
+        } finally {target.close()}
+    }
+
+    @Test fun inaccessibleOutputReportsFailureWithoutChangingFactsAndErasesPassword()=runTest {
+        seedUnknown();val before=finance.portableSnapshot();val key=password()
+        val unreachable=java.io.File(files.root,"missing-parent/output.lifeos")
+        assertTrue(EncryptedBackupManager.export(context,LocalWardrobeRepository(context),Uri.fromFile(unreachable),db,key).isFailure)
+        assertTrue(key.all {it=='\u0000'});assertEquals(before,finance.portableSnapshot());assertScratchClean()
+    }
+}
diff --git a/app/src/test/java/com/qq/closie/life/finance/FinanceAssistantProviderTest.kt b/app/src/test/java/com/qq/closie/life/finance/FinanceAssistantProviderTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..dbe1d7b43e39b23526183ea26dd4532ebca606d4
--- /dev/null
+++ b/app/src/test/java/com/qq/closie/life/finance/FinanceAssistantProviderTest.kt
@@ -0,0 +1,49 @@
+package com.qq.closie.life.finance
+
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.*
+import org.junit.Test
+
+class FinanceAssistantProviderTest {
+    private class Fake(val action: () -> Unit = {}, val output: FinanceAssistanceResult = FinanceAssistanceResult.Explanation("合成解释")) : FinanceAssistantProvider {
+        override val id = "offline-fake"
+        override val transport = FinanceProviderTransport.LOCAL_FAKE
+        override val capabilities = FinanceAssistantCapability.entries.toSet()
+        var received = 0
+        override suspend fun assist(request: FinanceAssistanceRequest): FinanceAssistanceResult { received++; action(); return output }
+    }
+    private fun grants() = listOf(FinanceReadPurpose.AI_READ, FinanceReadPurpose.CLOUD_SEND).map {
+        FinancePurposeGrantEntity(it.name, it, "offline-fake", true, false, false, 10_000, 0, 0)
+    }
+    private val scope get() = grants().map { FinanceGrantEventEntity(it.id,"event") }
+    private fun request() = FinanceAssistanceRequest("request", FinanceAssistantCapability.EXPLANATION, "合成问题",
+        FinanceDisclosurePlan("offline-fake", setOf("event"), setOf("amount"), "AI_READ", "CLOUD_SEND"),
+        listOf(DisclosedFinanceRow("event","CNY",200,null,null)), "revision",1,0)
+
+    @Test fun T09_defaultOffAndSeparatePurposeScopeStopProviderBeforeData() = runTest {
+        val fake = Fake()
+        var policy = FinanceAssistancePolicy(false,0,"revision",grants(),scope)
+        val coordinator = FinanceAssistantCoordinator({ policy }) { 1_000 }
+        assertTrue(runCatching { coordinator.request(fake,request()) }.isFailure)
+        policy = policy.copy(enabled = true, grants = grants().filter { it.purpose == FinanceReadPurpose.AI_READ })
+        assertTrue(runCatching { coordinator.request(fake,request()) }.isFailure)
+        policy = policy.copy(grants = grants(), scope = emptyList())
+        assertTrue(runCatching { coordinator.request(fake,request()) }.isFailure)
+        assertEquals(0,fake.received)
+        policy = policy.copy(scope = scope)
+        assertEquals(FinanceAssistanceResult.Explanation("合成解释"),coordinator.request(fake,request()))
+        assertEquals(1,fake.received)
+    }
+    @Test fun T10_inFlightRevocationAndHostileResultCannotWriteOrExpandScope() = runTest {
+        var policy = FinanceAssistancePolicy(true,0,"revision",grants(),scope)
+        val coordinator = FinanceAssistantCoordinator({ policy }) { 1_000 }
+        val revoke = Fake({ policy = policy.copy(enabled = false) })
+        assertTrue(runCatching { coordinator.request(revoke,request()) }.isFailure)
+        policy = policy.copy(enabled = true)
+        val hostile = Fake(output = FinanceAssistanceResult.QuerySuggestion(FinanceQuerySpec(eventIds = setOf("ungranted"))))
+        assertTrue(runCatching { coordinator.request(hostile,request()) }.isFailure)
+        val text = Fake(output = FinanceAssistanceResult.ChangeSuggestion("DELETE FROM finance_entries"))
+        // An untrusted suggestion remains inert text: there is no canonical owner in the interface.
+        assertEquals(text.output,coordinator.request(text,request()))
+    }
+}

+        OutlinedTextField(description, { description = it }, Modifier.fillMaxWidth(),
+            label = { Text(if (kind == FinanceEditorKind.TRANSFER) "备注（可留空）" else "具体事由 · 买了什么 / 为了什么") }, enabled = !state.busy)
+        if (kind != FinanceEditorKind.TRANSFER) {

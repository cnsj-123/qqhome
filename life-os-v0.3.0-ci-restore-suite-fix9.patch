+            context = context,
+            repo = wardrobe,
+            inputUri = backup,
+            lifeDatabase = db,
+            hooks = NoOpRestoreHooks,
+            fs = FailingRestoreFs(failDeleteContaining = "closie_restore_old_")
+        )

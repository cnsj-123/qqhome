From dcc718172b8eb0a756e6eff06331216fdadac59d Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 11 Oct 2026 01:01:27 +0800
Subject: [PATCH 1/2] fix(ci): generate Room schema before migration tests

---
 .github/workflows/android.yml | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/.github/workflows/android.yml b/.github/workflows/android.yml
index 99c2fcdd8e8fe04de7673a5033bbf483ad994d8b..ca876a22bc5fc61daa4ac2ef36b3b2bdf3257e90 100644
--- a/.github/workflows/android.yml
+++ b/.github/workflows/android.yml
@@ -22,6 +22,14 @@ jobs:
           java-version: '17'
       - uses: gradle/actions/setup-gradle@v4
 
+      # Generate schema assets before the unit-test invocation merges debug assets.
+      - name: Generate Room schema
+        run: ./gradlew :app:kspDebugKotlin --stacktrace
+      - name: Verify Room v4 schema
+        shell: bash
+        run: |
+          test -f app/schemas/com.qq.closie.life.data.database.LifeDatabase/4.json
+
       # Includes Room migration, repository and restore-safety regression tests.
       - name: Unit tests
         run: ./gradlew :app:testDebugUnitTest --stacktrace
@@ -40,6 +48,13 @@ jobs:
           name: unit-test-report-build${{ github.run_number }}
           path: app/build/reports/tests/testDebugUnitTest/
           if-no-files-found: ignore
+      - name: Upload Room schema
+        uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: room-schema-build${{ github.run_number }}
+          path: app/schemas/com.qq.closie.life.data.database.LifeDatabase/4.json
+          if-no-files-found: error
 
       # These secret-bearing steps are skipped on PR/feature/manual feature runs.
       - name: Check release signing availability
-- 
2.53.0.windows.3



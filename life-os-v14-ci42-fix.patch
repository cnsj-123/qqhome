From 0eac386f5060efe0c6f92b9e460b0a23353ad165 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 11 Oct 2026 18:35:24 +0800
Subject: [PATCH] fix(lifeos): enforce function page back priority and align
 finance smoke test

---
 .../main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt    | 10 ++++++++++
 .../closie/ui/lifeos/components/LifeFunctionPages.kt   |  6 ------
 .../qq/closie/ui/lifeos/finance/FinanceSmokeTest.kt    |  4 +++-
 3 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt b/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt
index 836f2fd..aad46d4 100644
--- a/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt
+++ b/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt
@@ -1,5 +1,6 @@
 package com.qq.closie.ui.lifeos
 
+import androidx.activity.compose.BackHandler
 import androidx.compose.foundation.layout.fillMaxSize
 import androidx.compose.foundation.layout.safeDrawingPadding
 import androidx.compose.foundation.layout.consumeWindowInsets
@@ -120,6 +121,15 @@ fun LifeOsRoot(
             }
         }
         }
+        // Register when opened, after module content. Re-enabling an older callback would
+        // leave it below NavHost callbacks registered later. Leased editors/viewers keep Back.
+        if (drawerOpen && gesturePolicy.blockers == 0 && !captureMenu && intakeError == null) {
+            BackHandler {
+                val cancelReorder = gesturePolicy.cancelReorder
+                if (cancelReorder != null) cancelReorder() else drawerOpen = false
+            }
+        }
+        // Dialog/sheet hosts retain modal Back priority over the shell callback.
         com.qq.closie.ui.lifeos.finance.FinanceGlobalReviewHost(lifeContainer)
         if (captureMenu) CaptureMenuHost(intake, onDismiss = { captureMenu = false },
             onManual = { nav.navigateLifeTopLevel(LifeOsRoute.capture(LifeOsRoute.NEW_ID)) })
diff --git a/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt b/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt
index 1937d71..682fdaf 100644
--- a/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt
+++ b/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt
@@ -1,6 +1,5 @@
 package com.qq.closie.ui.lifeos.components
 
-import androidx.activity.compose.BackHandler
 import androidx.compose.animation.core.animate
 import androidx.compose.animation.core.tween
 import androidx.compose.foundation.background
@@ -154,9 +153,4 @@ fun LifeFunctionPages(
             }
         }
     }
-    // Register after nested module handlers: back closes this surface before navigating.
-    val policy = LocalFunctionPagePolicy.current
-    BackHandler(open || revealed) {
-        policy?.cancelReorder?.invoke() ?: onOpenChange(false)
-    }
 }
diff --git a/app/src/test/java/com/qq/closie/ui/lifeos/finance/FinanceSmokeTest.kt b/app/src/test/java/com/qq/closie/ui/lifeos/finance/FinanceSmokeTest.kt
index aba2190..1d43d03 100644
--- a/app/src/test/java/com/qq/closie/ui/lifeos/finance/FinanceSmokeTest.kt
+++ b/app/src/test/java/com/qq/closie/ui/lifeos/finance/FinanceSmokeTest.kt
@@ -80,7 +80,9 @@ class FinanceSmokeTest {
         assertEquals(99_000L, FinanceProjection.balance(snapshot().accounts.single(), snapshot().entries))
         compose.onNodeWithText("流水").performClick()
         compose.onNode(hasSetTextAction() and hasText("搜索事由、分类、标签或账户")).performScrollTo().performTextReplacement("出门")
-        compose.onNodeWithText("早餐豆浆").assertExists()
+        compose.waitForIdle()
+        compose.onNodeWithTag("finance-ledger").performScrollToNode(hasText("早餐豆浆"))
+        compose.onNodeWithText("早餐豆浆").assertIsDisplayed()
         click("早餐豆浆")
         click("作废这笔记录")
         compose.onNodeWithText("确认作废").performClick(); saved()
-- 

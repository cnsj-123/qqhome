From acb6ddea77d57e9a17d40ea42b178e4de9b30daf Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 12 Oct 2026 21:35:21 +0800
Subject: [PATCH] fix(android): acquire ordinary function page swipes on main
 pass

---
 .../qq/closie/ui/lifeos/components/LifeFunctionPages.kt  | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt b/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt
index 81fccc4..926930e 100644
--- a/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt
+++ b/app/src/main/java/com/qq/closie/ui/lifeos/components/LifeFunctionPages.kt
@@ -52,12 +52,13 @@ fun LifeFunctionPages(
             .pointerInput(enabled, travel, edge, horizontalPages) {
                 if (!enabled) return@pointerInput
                 awaitEachGesture {
-                    val down = awaitFirstDown(requireUnconsumed = false, pass = androidx.compose.ui.input.pointer.PointerEventPass.Initial)
+                    val financeOpening = !currentOpen && horizontalPages
+                    val pass = if (financeOpening)
+                        androidx.compose.ui.input.pointer.PointerEventPass.Initial else androidx.compose.ui.input.pointer.PointerEventPass.Main
+                    val down = awaitFirstDown(requireUnconsumed = false, pass = pass)
                     if (down.position.x <= edge || down.position.x >= size.width - edge) return@awaitEachGesture
                     val inCorridor = down.position.x < corridor
-                    if (!currentOpen && horizontalPages && !inCorridor) return@awaitEachGesture
-                    val pass = if (!currentOpen && horizontalPages && inCorridor)
-                        androidx.compose.ui.input.pointer.PointerEventPass.Initial else androidx.compose.ui.input.pointer.PointerEventPass.Main
+                    if (financeOpening && !inCorridor) return@awaitEachGesture
                     var owned = false
                     val tracker = VelocityTracker()
                     tracker.addPosition(down.uptimeMillis, down.position)
-- 

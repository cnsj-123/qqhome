+        assertThat(repo.updateOcrText(ref.id, "识别出来的文字", now = 2_000L)).isTrue()
+
+        assertThat(repo.getById(ref.id)!!.ocrText).isEqualTo("识别出来的文字")
+        assertThat(life.getEntity(ref.lifeEntityId)!!.revision).isEqualTo(2L)
+    }

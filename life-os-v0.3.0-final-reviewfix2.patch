 @Composable
 internal fun LifeHomeContent(
     recent: List<CaptureItemEntity>,
+    upcoming: List<PlanItemEntity>,
     onQuickCapture: () -> Unit,
+    onOpenRecord: (String) -> Unit = {},
+    onOpenPlan: () -> Unit = {},

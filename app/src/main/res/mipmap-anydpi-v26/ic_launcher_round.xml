<?xml version="1.0" encoding="utf-8"?>
<!--
  Round adaptive icon. Same three layers as ic_launcher.xml — on API 26+ the launcher applies the
  round mask itself, so the artwork must NOT also be pre-masked here (doing so would double-mask
  and leave a visible ring of Paper inside the circle).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>

Date: Tue, 20 Oct 2026 15:23:30 +0800
Subject: [PATCH] fix(ui): stabilize drawer Back ownership and reorder cleanup

---
 .../com/qq/closie/ui/lifeos/LifeOsRoot.kt     | 13 ++-
 .../lifeos/components/FunctionPagePolicy.kt   |  8 +-
 .../ui/lifeos/drawer/FunctionModuleGrid.kt    | 22 +++--
 .../qq/closie/ui/lifeos/ClosetSmokeTest.kt    | 84 +++++++++++++++----
 4 files changed, 92 insertions(+), 35 deletions(-)

diff --git a/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt b/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt
index 3b89e738219e9f9eb18b68591f73daf9db12ca7f..10f2fb48955909e6da63a4de7d73b425fbc3c9fb 100644
--- a/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt
+++ b/app/src/main/java/com/qq/closie/ui/lifeos/LifeOsRoot.kt
@@ -118,7 +118,7 @@ fun LifeOsRoot(
                             drawerOpen = false
                             if (module.id == "capture") captureMenu = true
                             else nav.navigateLifeTopLevel(module.route)
-                        }, onClose = { drawerOpen = false }, moduleOrder = appearance.moduleOrder,
+                        }, onClose = { drawerOpen = false }, active = drawerOpen, moduleOrder = appearance.moduleOrder,
                             onSaveOrder = appearanceViewModel::saveModuleOrder)
                     }
                 ) {
@@ -136,13 +136,10 @@ fun LifeOsRoot(
             }
         }
         }
-        // Register when opened, after module content. Re-enabling an older callback would
-        // leave it below NavHost callbacks registered later. Leased editors/viewers keep Back.
-        if (drawerOpen && gesturePolicy.blockers == 0 && !captureMenu && intakeError == null) {
-            BackHandler {
-                val cancelReorder = gesturePolicy.cancelReorder
-                if (cancelReorder != null) cancelReorder() else drawerOpen = false
-            }
+        // Keep registration stable after module content. A closed drawer yields to the
+        // module/NavHost, and leased editors/viewers keep their own modal Back priority.
+        BackHandler(enabled = drawerOpen && gesturePolicy.blockers == 0 && !captureMenu && intakeError == null) {
+            if (!gesturePolicy.cancelActiveReorder()) drawerOpen = false
         }
         // Dialog/sheet hosts retain modal Back priority over the shell callback.
         com.qq.closie.ui.lifeos.finance.FinanceGlobalReviewHost(lifeContainer)
diff --git a/app/src/main/java/com/qq/closie/ui/lifeos/components/FunctionPagePolicy.kt b/app/src/main/java/com/qq/closie/ui/lifeos/components/FunctionPagePolicy.kt
index c8f3c41221e85fb7795af85f693e4f9359e2fecc..c63952480a6b61cc97544a467641fc730a2fb078 100644
--- a/app/src/main/java/com/qq/closie/ui/lifeos/components/FunctionPagePolicy.kt
+++ b/app/src/main/java/com/qq/closie/ui/lifeos/components/FunctionPagePolicy.kt
@@ -8,7 +8,13 @@ import com.qq.closie.navigation.LifeOsRoute
 class FunctionPagePolicy {
     /** A navigation intent only. Local Finance regions recognize their own gestures. */
     var requestDrawer: (() -> Unit)? = null
-    var cancelReorder: (() -> Unit)? = null
+    /** True only when the visible drawer actually cancelled a live reorder. */
+    var cancelReorder: (() -> Boolean)? = null
+    fun cancelActiveReorder(): Boolean {
+        val cancel = cancelReorder ?: return false
+        cancelReorder = null
+        return cancel()
+    }
     var blockers by mutableIntStateOf(0)
         private set
     fun acquire() { blockers++ }
diff --git a/app/src/main/java/com/qq/closie/ui/lifeos/drawer/FunctionModuleGrid.kt b/app/src/main/java/com/qq/closie/ui/lifeos/drawer/FunctionModuleGrid.kt
index a4153cf4db2e6778648ba97124fc3af5c2cfa25e..0e656623de7db9e9d05cd935ac6d562c5490a830 100644
--- a/app/src/main/java/com/qq/closie/ui/lifeos/drawer/FunctionModuleGrid.kt
+++ b/app/src/main/java/com/qq/closie/ui/lifeos/drawer/FunctionModuleGrid.kt
@@ -36,6 +36,7 @@ import kotlinx.coroutines.delay
 @OptIn(androidx.compose.foundation.ExperimentalFoundationApi::class)
 @Composable
 fun LifeOsDrawer(onOpenModule: (LifeModule) -> Unit, onClose: () -> Unit, modifier: Modifier = Modifier,
+    active: Boolean = true,
     moduleOrder: List<String> = emptyList(),
     onSaveOrder: (List<String>, () -> Unit, (String) -> Unit) -> Unit = { _, done, _ -> done() }) {
     val colors = LocalLifeOsColors.current
@@ -54,14 +55,18 @@ fun LifeOsDrawer(onOpenModule: (LifeModule) -> Unit, onClose: () -> Unit, modifi
     val save by rememberUpdatedState(onSaveOrder)
     LaunchedEffect(moduleOrder) { if (lifted == null && !saving) modules = orderedModules(moduleOrder) }
     val policy = com.qq.closie.ui.lifeos.components.LocalFunctionPagePolicy.current
-    fun cancel() {
+    fun cancel(): Boolean {
         policy?.cancelReorder = null
-        if (lifted == null || saving) return
+        if (lifted == null || saving) return false
         modules = baseline; lifted = null; message = "已取消移动"
+        return true
     }
-    DisposableEffect(lifted?.id, policy) {
-        policy?.cancelReorder = if (lifted != null) ({ cancel() }) else null
-        onDispose { policy?.cancelReorder = null }
+    // The function page stays composed while hidden; hidden reorders must not own Back.
+    LaunchedEffect(active) { if (!active) cancel() }
+    DisposableEffect(active, lifted?.id, saving, policy) {
+        val cancellation: (() -> Boolean)? = if (active && lifted != null && !saving) ({ cancel() }) else null
+        policy?.cancelReorder = cancellation
+        onDispose { if (policy?.cancelReorder === cancellation) policy?.cancelReorder = null }
     }
     fun persist(previous: List<LifeModule>, restoreDefault: Boolean = false) {
         policy?.cancelReorder = null
@@ -101,11 +106,12 @@ fun LifeOsDrawer(onOpenModule: (LifeModule) -> Unit, onClose: () -> Unit, modifi
             delay(16)
         }
     }
-    BackHandler(lifted != null) { cancel() }
+    // The shell handles cancellation when hosted there; standalone drawers retain Back.
+    BackHandler(enabled = active && lifted != null && !saving && policy == null) { cancel() }
     Box(modifier.fillMaxHeight()) {
         LazyVerticalGrid(GridCells.Fixed(2), state = grid, modifier = Modifier.fillMaxSize().testTag("life-drawer")
-            .pointerInput(saving) {
-                if (saving) return@pointerInput
+            .pointerInput(active, saving) {
+                if (!active || saving) return@pointerInput
                 detectDragGesturesAfterLongPress(onDragStart = { point ->
                     val item = grid.layoutInfo.visibleItemsInfo.firstOrNull {
                         point.x >= it.offset.x && point.x < it.offset.x + it.size.width &&
diff --git a/app/src/test/java/com/qq/closie/ui/lifeos/ClosetSmokeTest.kt b/app/src/test/java/com/qq/closie/ui/lifeos/ClosetSmokeTest.kt

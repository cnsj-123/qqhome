+          path: app/build/outputs/apk/release/*.apk
+          if-no-files-found: error
+      - name: Remove temporary release keystore
+        if: always() && github.ref == 'refs/heads/main' && steps.signing.outputs.available == 'true'
+        shell: bash
+        run: rm -f "$RUNNER_TEMP/lifeos-release.jks"

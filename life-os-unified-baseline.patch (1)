+      # These secret-bearing steps are skipped on PR/feature/manual feature runs.
+      - name: Check release signing availability
+        id: signing
+        if: github.ref == 'refs/heads/main'
+        env:
+          KEYSTORE_B64: ${{ secrets.LIFEOS_SIGNING_KEYSTORE_BASE64 }}
+          STORE_PASSWORD: ${{ secrets.LIFEOS_SIGNING_STORE_PASSWORD }}
+          KEY_ALIAS: ${{ secrets.LIFEOS_SIGNING_KEY_ALIAS }}
+          KEY_PASSWORD: ${{ secrets.LIFEOS_SIGNING_KEY_PASSWORD }}
+        shell: bash
+        run: |
+          if [[ -n "$KEYSTORE_B64" && -n "$STORE_PASSWORD" && -n "$KEY_ALIAS" && -n "$KEY_PASSWORD" ]]; then

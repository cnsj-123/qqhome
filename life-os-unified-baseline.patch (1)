+          LIFEOS_KEY_ALIAS: ${{ secrets.LIFEOS_SIGNING_KEY_ALIAS }}
+          LIFEOS_KEY_PASSWORD: ${{ secrets.LIFEOS_SIGNING_KEY_PASSWORD }}
